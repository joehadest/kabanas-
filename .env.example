# Supabase — pegue em https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Identificador da loja padrão (single-tenant). Ver tabela store_settings.
NEXT_PUBLIC_STORE_SLUG=kabanas

# URL pública do app — base do domínio (sem /admin). Painel em /admin/...
# Vercel (produção):
# NEXT_PUBLIC_APP_URL=https://kabanasbeer.webpulseservicos.com
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
