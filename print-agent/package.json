{
  "name": "kabanas-print-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Kabanas Impressão — agente local com instalador Windows",
  "author": "Kabanas Beer",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:cli": "node src/index.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dist:app": "npm run icons && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir",
    "dist:portable": "npm run icons && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "dist:installer": "npm run dist:app && node scripts/build-inno.mjs",
    "dist": "npm run dist:installer"
  },
  "build": {
    "appId": "com.kabanas.printagent",
    "productName": "Kabanas Impressao",
    "copyright": "Copyright © Kabanas Beer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5",
    "to-ico": "^1.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}
